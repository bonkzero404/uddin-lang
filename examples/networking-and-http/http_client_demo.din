// HTTP Client Demo - Demonstration of HTTP client features in Uddin-Lang
// File: 17_http_client_demo.din

import "http"

fun main():
    print("=== HTTP Client Demo ===")
    print("")

    // Demo 1: HTTP GET request
    print("1. HTTP GET Request:")
    try_get_request()
    print("")

    // Demo 2: HTTP POST request
    print("2. HTTP POST Request:")
    try_post_request()
    print("")

    // Demo 3: HTTP PUT request
    print("3. HTTP PUT Request:")
    try_put_request()
    print("")

    // Demo 4: HTTP DELETE request
    print("4. HTTP DELETE Request:")
    try_delete_request()
    print("")

    print("=== HTTP Client Demo Complete ===")
    print("Available features:")
    print("- http.get(url)")
    print("- http.post(url, data, headers?)")
    print("- http.put(url, data, headers?)")
    print("- http.delete(url)")
    print("- http.request(method, url, data?, headers?)")
end

// Demo HTTP GET request
fun try_get_request():
    print("  Making GET request to JSONPlaceholder...")

    // GET request ke API publik
    response = http.get("https://jsonplaceholder.typicode.com/posts/1")

    print("  Status: " + str(response["status"]))
    print("  Status Text: " + response["status_text"])

    // Display response body
    body = response["body"]
    if (typeof(body) == "object") then:
        print("  Title: " + body.title)
        print("  User ID: " + str(body["userId"]))
    else:
        print("  Body: " + str(body))
    end
end

// Demo HTTP POST request
fun try_post_request():
    print("  Making POST request to JSONPlaceholder...")

    // Data to send
    post_data = {
        "title": "Uddin-Lang HTTP Client",
        "body": "Testing HTTP POST from Uddin-Lang",
        "userId": 1
    }

    // POST request
    response = http.post("https://jsonplaceholder.typicode.com/posts", post_data)

    print("  Status: " + str(response["status"]))
    print("  Status Text: " + response["status_text"])

    // Display response body
    body = response["body"]
    if (typeof(body) == "object") then:
        print("  Created ID: " + str(body["id"]))
        print("  Title: " + body["title"])
    end
end

// Demo HTTP PUT request
fun try_put_request():
    print("  Making PUT request to JSONPlaceholder...")

    // Data for update
    put_data = {
        "id": 1,
        "title": "Updated Title from Uddin-Lang",
        "body": "Updated content using HTTP PUT",
        "userId": 1
    }

    // PUT request to update resource
    response = http.put("https://jsonplaceholder.typicode.com/posts/1", put_data)

    print("  Status: " + str(response["status"]))
    print("  Status Text: " + response["status_text"])

    // Display response body
    body = response["body"]
    if (typeof(body) == "object") then:
        print("  Updated ID: " + str(body["id"]))
        print("  Updated Title: " + body["title"])
    end
end

// Demo HTTP DELETE request
fun try_delete_request():
    print("  Making DELETE request...")

    response = http.delete("https://jsonplaceholder.typicode.com/posts/1")

    print("  Status: " + str(response["status"]))
    print("  Status Text: " + response["status_text"])

    if (response["status"] == 200) then:
        print("  Resource successfully deleted!")
    else:
        print("  Problem occurred while deleting resource")
    end
end
