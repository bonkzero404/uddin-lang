// Demo of networking functionality in Uddin-Lang
// Demonstrating TCP, UDP, and network utilities

import "http"

print("=== Uddin-Lang Networking Demo ===")

// Demo 1: Network Utilities
print("\n--- Demo 1: Network Utilities ---")

// Resolve hostname ke IP address
print("Resolving google.com...")
result = http.net_resolve("google.com")
if (result.success) then:
    print("IP addresses for google.com:")
    for (i in range(len(result.ips))):
        print("  " + str(i+1) + ". " + result.ips[i])
    end
else:
    print("DNS resolution failed: " + result.error)
end

// Ping test
print("\nPing test to google.com:80...")
ping_result = http.net_ping("google.com", 80, 3000)
if (ping_result["success"]) then:
    print("Ping successful! Time: " + str(ping_result["time_ms"]) + "ms")
else:
    print("Ping failed: " + ping_result["error"])
end

// Demo 2: TCP Client
print("\n--- Demo 2: TCP Client ---")

// Connect to HTTP server (google.com:80)
print("Connecting to google.com:80...")
tcp_conn = tcp_connect("google.com", 80)
print("Connected! Address: " + tcp_conn["address"])

// Send simple HTTP request
http_request = "GET / HTTP/1.1\r\nHost: google.com\r\nConnection: close\r\n\r\n"
bytes_written = tcp_write(tcp_conn, http_request)
print("Sent " + str(bytes_written) + " bytes")

// Read response
response = tcp_read(tcp_conn, 1024)
print("Received response (first 200 chars):")
if (len(response) > 200) then:
    print(substr(response, 0, 200) + "...")
else:
    print(response)
end

// Close connection
tcp_close(tcp_conn)
print("TCP connection closed")

// Demo 3: UDP Client (Echo Test)
print("\n--- Demo 3: UDP Client ---")

// UDP connection to echo server (echo.websocket.org:80)
print("Connecting to echo.websocket.org:80...")
udp_conn = udp_connect("echo.websocket.org", 80)
print("UDP connection established")

// Send simple message
test_message = "Hello from Uddin-Lang UDP client!"
bytes_sent = udp_write(udp_conn, test_message)
print("Sent message: " + str(bytes_sent) + " bytes")
print("Message: " + test_message)

// Close UDP connection
udp_close(udp_conn)
print("UDP connection closed")

// Demo 4: UDP Server (Listen Mode)
print("\n--- Demo 4: UDP Server (Listen Mode) ---")
print("Creating UDP listener on port 12345...")
udp_listener = udp_listen(12345)
print("UDP listener created: " + udp_listener["address"])
print("Note: This would normally wait for incoming connections")

// Close listener
udp_close(udp_listener)
print("UDP listener closed")

print("\n=== Networking Demo Complete ===")
