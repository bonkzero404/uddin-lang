// Memoization Demo - Demonstrating function caching in Uddin
// This example shows how memoization works and its performance benefits

// Example 1: Fibonacci without memoization (slow for large numbers)
fun fibonacci_slow(n):
    if (n <= 1) then:
        return n
    end
    return fibonacci_slow(n - 1) + fibonacci_slow(n - 2)
end

// Example 2: Factorial with memoization (automatically cached)
fun factorial_memo(n):
    if (n <= 1) then:
        return 1
    end
    return n * factorial_memo(n - 1)
end

// Example 3: Expensive computation that benefits from memoization
fun expensive_computation(x, y):
    print("Computing for x=" + str(x) + ", y=" + str(y))
    
    // Simulate expensive operation
    result = 0
    for (i in range(1000)):
        result = result + (x * y * i)
    end
    
    return result
end

// Example 4: Function with side effects (not memoized)
fun print_message(msg):
    print("Message: " + msg)
    print("This function has side effects and returns null")
    return null  // Functions returning null are not memoized
end

// Example 5: Pure function that gets memoized
fun power_calculation(base, exponent):
    print("Calculating " + str(base) + "^" + str(exponent))
    result = 1
    for (i in range(exponent)):
        result = result * base
    end
    return result
end

fun main():
    print("🧠 Memoization Demo in Uddin")
    print("=" * 40)
    
    print("\n1. Fibonacci (slow without memoization):")
    print("fibonacci_slow(10) = " + str(fibonacci_slow(10)))
    
    print("\n2. Factorial (with automatic memoization):")
    print("factorial_memo(5) = " + str(factorial_memo(5)))
    print("factorial_memo(5) = " + str(factorial_memo(5))) // Second call uses cache
    
    print("\n3. Expensive computation demo:")
    print("First call:")
    result1 = expensive_computation(5, 3)
    print("Result: " + str(result1))
    
    print("\nSecond call (should use cache):")
    result2 = expensive_computation(5, 3)
    print("Result: " + str(result2))
    
    print("\nThird call with different parameters:")
    result3 = expensive_computation(7, 2)
    print("Result: " + str(result3))
    
    print("\n4. Side effect function (not memoized):")
    print_message("Hello World")
    print_message("Hello World") // This will print again (not cached)
    
    print("\n5. Pure function memoization:")
    print("First call:")
    power1 = power_calculation(2, 8)
    print("Result: " + str(power1))
    
    print("\nSecond call (cached):")
    power2 = power_calculation(2, 8)
    print("Result: " + str(power2))
    
    print("\n📊 Memoization Summary:")
    print("✅ Functions returning non-null values are automatically memoized")
    print("❌ Functions returning null (side effects) are not memoized")
    print("🚀 Memoization provides significant performance improvements")
    print("💡 Cache is based on function name + parameters")
end