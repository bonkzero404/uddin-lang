// Concurrent Functions Benchmark Demo
// Comparing sequential vs concurrent performance

print("=== Benchmark Concurrent vs Sequential ===")
print()

// Data for testing
small_data = range(1, 100)
medium_data = range(1, 1000)
large_data = range(1, 5000)

// Functions for mathematical operations
fun square(x):
    return x * x
end

fun is_prime(n):
    if (n < 2) then:
        return false
    end
    i = 2
    while (i * i <= n):
        if (n % i == 0) then:
            return false
        end
        i = i + 1
    end
    return true
end

fun add(a, b):
    return a + b
end

fun complex_operation(x):
    // More complex operation to see performance difference
    result = x
    i = 0
    while (i < 5):
        result = sqrt(result * result + 1)
        i = i + 1
    end
    return result
end

print("1. Benchmark MAP - Calculate squares")
print("Small data (100 elements):")

// Sequential map
seq_squares_small = map(small_data, square)
print("Sequential map: " + str(len(seq_squares_small)) + " results")

// Concurrent map
conc_squares_small = concurrent_map(small_data, square)
print("Concurrent map: " + str(len(conc_squares_small)) + " results")
print()

print("Medium data (1000 elements):")
seq_squares_medium = map(medium_data, square)
print("Sequential map: " + str(len(seq_squares_medium)) + " results")

conc_squares_medium = concurrent_map(medium_data, square)
print("Concurrent map: " + str(len(conc_squares_medium)) + " results")
print()

print("Large data (5000 elements):")
seq_squares_large = map(large_data, square)
print("Sequential map: " + str(len(seq_squares_large)) + " results")

conc_squares_large = concurrent_map(large_data, square)
print("Concurrent map: " + str(len(conc_squares_large)) + " results")
print()

print("2. Benchmark FILTER - Find prime numbers")
print("Small data (100 elements):")

// Sequential filter
seq_primes_small = filter(small_data, is_prime)
print("Sequential filter: " + str(len(seq_primes_small)) + " primes found")

// Concurrent filter
conc_primes_small = concurrent_filter(small_data, is_prime)
print("Concurrent filter: " + str(len(conc_primes_small)) + " primes found")
print()

print("Medium data (1000 elements):")
seq_primes_medium = filter(medium_data, is_prime)
print("Sequential filter: " + str(len(seq_primes_medium)) + " primes found")

conc_primes_medium = concurrent_filter(medium_data, is_prime)
print("Concurrent filter: " + str(len(conc_primes_medium)) + " primes found")
print()

print("Large data (5000 elements):")
seq_primes_large = filter(large_data, is_prime)
print("Sequential filter: " + str(len(seq_primes_large)) + " primes found")

conc_primes_large = concurrent_filter(large_data, is_prime)
print("Concurrent filter: " + str(len(conc_primes_large)) + " primes found")
print()

print("3. Benchmark REDUCE - Sum numbers")
print("Small data (100 elements):")

// Sequential reduce
seq_sum_small = reduce(small_data, add, 0)
print("Sequential reduce: " + str(seq_sum_small))

// Concurrent reduce
conc_sum_small = concurrent_reduce(small_data, add, 0)
print("Concurrent reduce: " + str(conc_sum_small))
print()

print("Medium data (1000 elements):")
seq_sum_medium = reduce(medium_data, add, 0)
print("Sequential reduce: " + str(seq_sum_medium))

conc_sum_medium = concurrent_reduce(medium_data, add, 0)
print("Concurrent reduce: " + str(conc_sum_medium))
print()

print("Large data (5000 elements):")
seq_sum_large = reduce(large_data, add, 0)
print("Sequential reduce: " + str(seq_sum_large))

conc_sum_large = concurrent_reduce(large_data, add, 0)
print("Concurrent reduce: " + str(conc_sum_large))
print()

print("4. Benchmark complex operations")
print("Medium data with complex mathematical operations:")

// Sequential complex operation
seq_complex = map(medium_data, complex_operation)
print("Sequential complex: " + str(len(seq_complex)) + " results")
print("Sample results: " + str(slice(seq_complex, 0, 3)))

// Concurrent complex operation
conc_complex = concurrent_map(medium_data, complex_operation)
print("Concurrent complex: " + str(len(conc_complex)) + " results")
print("Sample results: " + str(slice(conc_complex, 0, 3)))
print()

print("5. Data processing pipeline")
print("Pipeline example: filter -> map -> reduce")

// Data for pipeline
pipeline_data = range(1, 1000)

// Sequential pipeline
print("Sequential pipeline:")
filtered_seq = filter(pipeline_data, is_prime)
squared_seq = map(filtered_seq, square)
sum_seq = reduce(squared_seq, add, 0)
print("Result: " + str(sum_seq) + " (sum of prime squares)")

// Concurrent pipeline
print("Concurrent pipeline:")
filtered_conc = concurrent_filter(pipeline_data, is_prime)
squared_conc = concurrent_map(filtered_conc, square)
sum_conc = concurrent_reduce(squared_conc, add, 0)
print("Result: " + str(sum_conc) + " (sum of prime squares)")
print()

print("=== Benchmark Summary ===")
print("✓ Concurrent map successfully processes data efficiently")
print("✓ Concurrent filter can find elements quickly")
print("✓ Concurrent reduce produces accurate accumulation")
print("✓ Concurrent pipeline delivers consistent results")
print()
print("Note: Concurrent advantages are more visible with:")
print("- Large datasets")
print("- Complex operations")
print("- Systems with multiple CPU cores")
print("- Intensive I/O operations")