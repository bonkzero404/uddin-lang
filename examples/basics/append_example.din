// =============================================================================
// Examples of Using append() in UDDIN-LANG
// =============================================================================

fun main():
    print("=== Examples of Using append() ===\n")
    
    // 1. Append a single element
    print("1. Append a single element:")
    numbers = [1, 2, 3]
    print("Before:", numbers)
    append(numbers, 4)
    print("After:", numbers)
    print()
    
    // 2. Append multiple elements at once
    print("2. Append multiple elements at once:")
    fruits = ["apple", "orange"]
    print("Before:", fruits)
    append(fruits, "mango", "banana", "grape")
    print("After:", fruits)
    print()
    
    // 3. Append within a loop
    print("3. Append within a loop:")
    squares = []
    for (i in range(1, 6)):
        append(squares, i * i)
    end
    print("Squares of 1-5:", squares)
    print()
    
    // 4. Append with condition
    print("4. Append with condition (only even numbers):")
    evens = []
    for (num in range(1, 11)):
        if (num % 2 == 0) then:
            append(evens, num)
        end
    end
    print("Even numbers 1-10:", evens)
    print()
    
    // 5. Append array into array
    print("5. Append nested array:")
    matrix = []
    row1 = [1, 2, 3]
    row2 = [4, 5, 6]
    append(matrix, row1)
    append(matrix, row2)
    print("Matrix:", matrix)
    print()
    
    // 6. Append string to string array
    print("6. Append string to array:")
    names = []
    append(names, "Alice")
    append(names, "Bob")
    append(names, "Charlie")
    print("Names:", names)
    print()
    
    // 7. Practical example: Collecting data
    print("7. Practical example - Collecting values above threshold:")
    scores = [45, 78, 92, 67, 85, 91, 56]
    high_scores = []
    threshold = 80
    
    for (score in scores):
        if (score >= threshold) then:
            append(high_scores, score)
        end
    end
    print("All scores:", scores)
    print("High scores (>= " + str(threshold) + "):", high_scores)
    print()
    
    // 8. Demonstrating that append modifies the original array (in-place)
    print("8. Append modifies the original array (in-place):")
    original = [10, 20]
    print("Original:", original)
    append(original, 30)
    print("After append:", original)
    print("Note: Array 'original' is modified, not creating a new array")
    print()
    
    // 9. Append different data types
    print("9. Append different data types:")
    mixed = []
    append(mixed, 42)           // integer
    append(mixed, "hello")      // string
    append(mixed, 3.14)         // float
    append(mixed, true)         // boolean
    append(mixed, [1, 2, 3])    // array
    print("Mixed array:", mixed)
    print()
    
    // 10. Example: Build array dynamically
    print("10. Build array dynamically:")
    result = []
    for (i in range(1, 6)):
        if (i % 2 == 1) then:
            append(result, "Odd: " + str(i))
        end
    end
    print("Dynamic result:", result)
end

