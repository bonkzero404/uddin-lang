// MySQL Multi-Table Real-time Streaming Example (Binlog Streaming)
// This example demonstrates how to use stream_tables with multiple MySQL tables
// using MySQL binary log (binlog) streaming for real-time CDC (Change Data Capture)

// Connect to MySQL database
print("Connecting to MySQL database...")
connResult = db_connect(
     "mysql",
     "localhost",
     3306,
     "testdb",
     "root",
     "janitrapanji"
 )

if (not connResult.success) then:
    print("❌ Failed to connect to MySQL database: " + connResult.error)
    exit(1)
end

mysql_conn = connResult.conn
print("✅ Successfully connected to MySQL database!")
print("")

// Create test tables if they don't exist
db_execute(mysql_conn, `
    CREATE TABLE IF NOT EXISTS users (
        id INT AUTO_INCREMENT PRIMARY KEY,
        name VARCHAR(100) NOT NULL,
        email VARCHAR(100) UNIQUE NOT NULL,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
    )
`)

db_execute(mysql_conn, `
    CREATE TABLE IF NOT EXISTS orders (
        id INT AUTO_INCREMENT PRIMARY KEY,
        user_id INT NOT NULL,
        product_name VARCHAR(200) NOT NULL,
        amount DECIMAL(10,2) NOT NULL,
        status ENUM('pending', 'completed', 'cancelled') DEFAULT 'pending',
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    )
`)

db_execute(mysql_conn, `
    CREATE TABLE IF NOT EXISTS products (
        id INT AUTO_INCREMENT PRIMARY KEY,
        name VARCHAR(200) NOT NULL,
        price DECIMAL(10,2) NOT NULL,
        stock INT DEFAULT 0,
        category VARCHAR(100),
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
    )
`)

print("MySQL tables 'users', 'orders', and 'products' created successfully")

// Enable MySQL binlog (required for binlog streaming)
db_execute(mysql_conn, "SET GLOBAL log_bin = ON")
db_execute(mysql_conn, "SET GLOBAL binlog_format = 'ROW'")
db_execute(mysql_conn, "SET GLOBAL binlog_row_image = 'FULL'")

print("MySQL binlog configuration enabled")

// Define callback function to handle real-time binlog events from multiple tables
fun onMultiTableStreamData(channel, payload):
    // Parse the JSON payload from binlog event
    change_data = json_parse(payload)
    
    table = change_data["table"]
    operation = change_data["operation"]
    timestamp = change_data["timestamp"]
    
    print("=== MySQL Binlog Event Received ===")
    print("Table: " + table)
    print("Operation: " + operation)
    print("Timestamp: " + timestamp)
    
    if operation == "INSERT" {
        new_data = change_data["new_data"]
        print("New Record:")
        print(json_stringify(new_data, true))
        
        if table == "users" {
            print("👤 New user created: " + new_data["name"] + " (" + new_data["email"] + ")")
        } else if table == "orders" {
            print("🛒 New order created: " + new_data["product_name"] + " - $" + str(new_data["amount"]))
        } else if table == "products" {
            print("📦 New product added: " + new_data["name"] + " - $" + str(new_data["price"]))
        }
        
    } else if operation == "UPDATE" {
        old_data = change_data["old_data"]
        new_data = change_data["new_data"]
        print("Updated Record:")
        print("Old: " + json_stringify(old_data, true))
        print("New: " + json_stringify(new_data, true))
        
        if table == "users" {
            print("👤 User updated: " + old_data["name"] + " → " + new_data["name"])
        } else if table == "orders" {
            print("🛒 Order updated: Status " + old_data["status"] + " → " + new_data["status"])
        } else if table == "products" {
            print("📦 Product updated: Stock " + str(old_data["stock"]) + " → " + str(new_data["stock"]))
        }
        
    } else if operation == "DELETE" {
        old_data = change_data["old_data"]
        print("Deleted Record:")
        print(json_stringify(old_data, true))
        
        if table == "users" {
            print("🗑️ User deleted: " + old_data["name"] + " (" + old_data["email"] + ")")
        } else if table == "orders" {
            print("🗑️ Order deleted: " + old_data["product_name"])
        } else if table == "products" {
            print("🗑️ Product deleted: " + old_data["name"])
        }
    }
    
    print("================================")
    print("")
end

// Start MySQL binlog streaming for multiple tables
print("Starting MySQL binlog streaming for multiple tables...")
print("Tables: users, orders, products")
print("This implementation reads directly from MySQL binary logs")
print("Latency: ~1-10ms (real-time)")
print("CPU Impact: <1% (minimal)")
print("Network: Only actual changes transmitted")
print("")
print("To test the multi-table stream, run these commands in another MySQL client:")
print("")
print("-- Test users table")
print("INSERT INTO users (name, email) VALUES ('Alice Smith', 'alice@example.com');")
print("UPDATE users SET name = 'Alice Johnson' WHERE email = 'alice@example.com';")
print("")
print("-- Test products table")
print("INSERT INTO products (name, price, stock, category) VALUES ('Laptop', 999.99, 10, 'Electronics');")
print("UPDATE products SET stock = 8 WHERE name = 'Laptop';")
print("")
print("-- Test orders table (make sure user_id exists)")
print("INSERT INTO orders (user_id, product_name, amount) VALUES (1, 'Laptop', 999.99);")
print("UPDATE orders SET status = 'completed' WHERE id = 1;")
print("")
print("Press Ctrl+C to stop streaming")
print("")

// Start the multi-table binlog stream (this will block and listen for changes)
stream_tables(mysql_conn, ["users", "orders", "products"], onMultiTableStreamData)

// Note: The stream_tables function will:
// 1. Connect to MySQL binlog replication stream
// 2. Read binary log events in real-time (like Debezium)
// 3. Filter events for specified tables only
// 4. Call onMultiTableStreamData function whenever changes are detected from any table
// 5. No database triggers or additional tables required
// 6. Provides true real-time CDC with minimal database impact

// Clean up (this won't be reached due to blocking nature)
db_close(mysql_conn)