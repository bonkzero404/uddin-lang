// PostgreSQL Multi-Table Real-time Streaming Example
// This example demonstrates how to use stream_tables with multiple PostgreSQL tables
// using LISTEN/NOTIFY approach for true real-time streaming

// Connect to PostgreSQL database
print("Connecting to PostgreSQL database...")
connResult = db_connect(
     "postgres",
     "localhost",
     5432,
     "testdb",
     "postgres",
     "password"
 )

if (not connResult.success) then:
    print("❌ Failed to connect to PostgreSQL database: " + connResult.error)
    exit(1)
end

postgres_conn = connResult.conn
print("✅ Successfully connected to PostgreSQL database!")
print("")

// Create test tables if they don't exist
db_execute(postgres_conn, `
    CREATE TABLE IF NOT EXISTS users (
        id SERIAL PRIMARY KEY,
        name VARCHAR(100) NOT NULL,
        email VARCHAR(100) UNIQUE NOT NULL,
        created_at TIMESTAMP DEFAULT NOW(),
        updated_at TIMESTAMP DEFAULT NOW()
    )
`)

db_execute(postgres_conn, `
    CREATE TABLE IF NOT EXISTS orders (
        id SERIAL PRIMARY KEY,
        user_id INT NOT NULL,
        product_name VARCHAR(200) NOT NULL,
        amount DECIMAL(10,2) NOT NULL,
        status VARCHAR(20) DEFAULT 'pending',
        created_at TIMESTAMP DEFAULT NOW(),
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
    )
`)

db_execute(postgres_conn, `
    CREATE TABLE IF NOT EXISTS products (
        id SERIAL PRIMARY KEY,
        name VARCHAR(200) NOT NULL,
        price DECIMAL(10,2) NOT NULL,
        stock INT DEFAULT 0,
        category VARCHAR(100),
        created_at TIMESTAMP DEFAULT NOW(),
        updated_at TIMESTAMP DEFAULT NOW()
    )
`)

print("PostgreSQL tables 'users', 'orders', and 'products' created successfully")

// Define callback function to handle real-time data changes from multiple tables
fun onMultiTableStreamData(channel, payload):
    print("=== PostgreSQL Multi-Table Stream Data Received ===")
    print("Channel: " + channel)
    print("Payload: " + payload)
    print("Time: " + str(time_now()))
    print("=============================================")
end

// Start streaming multiple tables
// This will create PostgreSQL triggers and LISTEN/NOTIFY for all tables
print("Starting PostgreSQL real-time streaming for multiple tables...")
print("Tables: users, orders, products")
print("PostgreSQL CDC uses LISTEN/NOTIFY approach for true real-time streaming")
print("No polling - instant notifications!")
print("")
print("To test the multi-table stream, run these commands in another PostgreSQL client:")
print("")
print("-- Test users table")
print("INSERT INTO users (name, email) VALUES ('Alice Smith', 'alice@example.com');")
print("UPDATE users SET name = 'Alice Johnson' WHERE email = 'alice@example.com';")
print("")
print("-- Test products table")
print("INSERT INTO products (name, price, stock, category) VALUES ('Laptop', 999.99, 10, 'Electronics');")
print("UPDATE products SET stock = 8 WHERE name = 'Laptop';")
print("")
print("-- Test orders table (make sure user_id exists)")
print("INSERT INTO orders (user_id, product_name, amount) VALUES (1, 'Laptop', 999.99);")
print("UPDATE orders SET status = 'completed' WHERE id = 1;")
print("")
print("Press Ctrl+C to stop streaming")
print("")

// Start the multi-table stream (this will block and listen for changes)
stream_tables(postgres_conn, ["users", "orders", "products"], onMultiTableStreamData)

// Note: The stream_tables function will:
// 1. Create PostgreSQL triggers on all specified tables
// 2. Set up LISTEN/NOTIFY channels for real-time notifications
// 3. Call onMultiTableStreamData function whenever changes are detected from any table
// 4. The callback will receive data with table name to identify the source

// Clean up (this won't be reached due to blocking nature)
db_close(postgres_conn)
