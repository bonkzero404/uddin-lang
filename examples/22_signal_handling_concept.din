// Konsep Signal Handling untuk Graceful Shutdown
// File ini mendemonstrasikan konsep bagaimana signal handling
// seharusnya diimplementasikan untuk graceful shutdown yang sesungguhnya

print("=== Konsep Signal Handling untuk Graceful Shutdown ===")
print("")

// Dalam implementasi nyata, kita memerlukan:
// 1. Signal handler untuk menangkap SIGINT (Ctrl+C)
// 2. Channel untuk komunikasi antar goroutine
// 3. Proper cleanup mechanism

print("Konsep implementasi signal handling:")
print("")
print("1. Setup Signal Handler:")
print("   - Menangkap SIGINT (Ctrl+C) dan SIGTERM")
print("   - Menggunakan os/signal package di Go")
print("   - Channel untuk komunikasi graceful shutdown")
print("")
print("2. Server Lifecycle:")
print("   - Server berjalan di background goroutine")
print("   - Main thread menunggu signal")
print("   - Ketika signal diterima, mulai graceful shutdown")
print("")
print("3. Graceful Shutdown Process:")
print("   - Stop menerima request baru")
print("   - Tunggu request yang sedang berjalan selesai")
print("   - Cleanup resources (database connections, files, etc.)")
print("   - Shutdown server")
print("")

// Simulasi server dengan graceful shutdown concept
print("=== Demo Simulasi Graceful Shutdown ===")
print("")

// Fungsi handler sederhana
fun simple_handler(req, res):
    print("Handling request: " + req["method"] + " " + req["path"])
    response_data = {
        "message": "Hello from graceful server!",
        "timestamp": time(),
        "status": "ok"
    }
    http_response(res, 200, {"Content-Type": "application/json"}, response_data)
end

// Setup server
port = 8080
server_id = "graceful-demo"

print("Memulai server pada port " + str(port) + "...")
server = http_server_start(port, server_id)

print("Server dimulai:")
print("  Type: " + server["type"])
print("  ID: " + server["server_id"])
print("  Port: " + str(server["port"]))
print("  Address: " + server["address"])
print("")

// Setup routes
http_server_route("GET", "/", simple_handler, server_id)
http_server_route("GET", "/test", simple_handler, server_id)

print("Routes dikonfigurasi:")
print("  GET /")
print("  GET /test")
print("")
print("Server tersedia di:")
print("  http://localhost:" + str(port) + "/")
print("  http://localhost:" + str(port) + "/test")
print("")

// Simulasi signal handling dengan timeout
print("=== Simulasi Signal Handling ===")
print("Dalam implementasi nyata:")
print("- Program akan menunggu SIGINT (Ctrl+C)")
print("- Ketika signal diterima, graceful shutdown dimulai")
print("- Server berhenti menerima request baru")
print("- Menunggu request aktif selesai")
print("- Cleanup dan shutdown")
print("")
print("Untuk demo ini, server akan berjalan 30 detik...")
print("")

// Simulasi server running
running_time = 0
max_time = 30

while (running_time < max_time):
    // Simulasi busy wait (dalam implementasi nyata menggunakan proper sleep)
    wait_counter = 0
    while (wait_counter < 50000):
        wait_counter = wait_counter + 1
    end

    running_time = running_time + 1

    // Status update setiap 5 detik
    if (running_time % 5 == 0) then:
        remaining = max_time - running_time
        print("Server berjalan... " + str(remaining) + " detik tersisa")
    end
end

// Simulasi graceful shutdown
print("")
print("=== Memulai Graceful Shutdown ===")
print("1. Signal SIGINT diterima (simulasi)")
print("2. Server berhenti menerima request baru")
print("3. Menunggu request aktif selesai...")

// Simulasi waiting for active requests
wait_time = 0
while (wait_time < 3):
    wait_counter = 0
    while (wait_counter < 30000):
        wait_counter = wait_counter + 1
    end
    wait_time = wait_time + 1
    print("   Menunggu... " + str(3 - wait_time) + " detik")
end

print("4. Semua request aktif selesai")
print("5. Cleanup resources...")
print("6. Shutdown server...")

// Stop server
http_server_stop(server_id)

print("")
print("=== Graceful Shutdown Selesai ===")
print("Server telah dihentikan dengan aman!")
print("")
print("Catatan untuk implementasi nyata:")
print("- Gunakan os/signal package untuk menangkap SIGINT/SIGTERM")
print("- Implementasikan context.Context untuk cancellation")
print("- Gunakan sync.WaitGroup untuk menunggu goroutine selesai")
print("- Tambahkan timeout untuk graceful shutdown")
print("- Log semua tahapan shutdown untuk debugging")
print("")
print("=== Demo Selesai ===")
