// HTTP Server Demo - Uddin-Lang
// This example demonstrates HTTP server capabilities in Uddin-Lang
// Features:
// - Starting HTTP server
// - Defining routes with handlers
// - Handling different HTTP methods (GET, POST, PUT, DELETE)
// - Working with request and response objects
// - JSON responses
// - Custom headers

print("=== HTTP Server Demo ===")

// Define handler functions
fun hello_handler(req, res):
    print("Received request:", req["method"], req["path"])
    
    // Send simple text response
    http_response(res, 200, {"Content-Type": "text/plain"}, "Hello from Uddin-Lang HTTP Server!")
end

fun api_users_handler(req, res):
    if (req["method"] == "GET") then:
        // Return list of users
        users = [
            {"id": 1, "name": "Alice", "email": "alice@example.com"},
            {"id": 2, "name": "Bob", "email": "bob@example.com"}
        ]
        
        http_response(res, 200, {"Content-Type": "application/json"}, users)
    else if (req["method"] == "POST") then:
        // Create new user (simplified)
        print("Creating new user with data:", req["body"])
        
        new_user = {"id": 3, "name": "Charlie", "email": "charlie@example.com"}
        http_response(res, 201, {"Content-Type": "application/json"}, new_user)
    else:
        // Method not allowed
        http_response(res, 405, {"Content-Type": "text/plain"}, "Method not allowed")
    end
end

fun health_check_handler(req, res):
    health_status = {
        "status": "healthy",
        "timestamp": date_now(),
        "server": "Uddin-Lang HTTP Server",
        "version": "1.0.0"
    }
    
    http_response(res, 200, {"Content-Type": "application/json"}, health_status)
end

// Start HTTP server on port 8080
print("Starting HTTP server on port 8080...")
server = http_server_start(8080, "main")
print("Server started successfully!")
print("Server type:", server["type"])
print("Server ID:", server["server_id"])
print("Server port:", server["port"])
print("Server address:", server["address"])

// Define routes
print("\nSetting up routes...")

// Basic routes
http_server_route("GET", "/", hello_handler, "main")
http_server_route("GET", "/hello", hello_handler, "main")
http_server_route("GET", "/health", health_check_handler, "main")

// API routes
http_server_route("GET", "/api/users", api_users_handler, "main")
http_server_route("POST", "/api/users", api_users_handler, "main")

print("Routes configured successfully!")

print("\n=== Server is running ===")
print("You can test the server with:")
print("- GET  http://localhost:8080/")
print("- GET  http://localhost:8080/hello")
print("- GET  http://localhost:8080/health")
print("- GET  http://localhost:8080/api/users")
print("- POST http://localhost:8080/api/users")

print("\nServer will run for 30 seconds for testing...")

// Keep the server running for a limited time for testing
i = 0
while (i < 30):
    // Server runs in background goroutine
    // This loop keeps the main program alive for 30 seconds
    print("Server running... " + str(30 - i) + " seconds remaining")
    i = i + 1
end

print("\nStopping server...")
http_server_stop("main")
print("Server stopped successfully!")

// Note: To run server indefinitely, replace the while loop with:
// while (true):
//     // Server runs indefinitely
// end