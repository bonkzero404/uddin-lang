// Demo HTTP Server dengan Graceful Shutdown
// Tekan Ctrl+C untuk menghentikan server dengan graceful

print("=== HTTP Server dengan Graceful Shutdown ===")
print("Tekan Ctrl+C untuk menghentikan server dengan aman")
print("")

// Fungsi handler untuk endpoint /hello
fun hello_handler(req, res):
    print("Request diterima: " + req["method"] + " " + req["path"])
    
    if (req["method"] == "GET") then:
        response_data = {
            "message": "Hello from Uddin-Lang HTTP Server!",
            "timestamp": time(),
            "path": req["path"],
            "method": req["method"]
        }
        http_response(res, 200, {"Content-Type": "application/json"}, response_data)
    else:
        http_response(res, 405, {"Content-Type": "application/json"}, {
            "error": "Method not allowed",
            "allowed_methods": ["GET"]
        })
    end
end

// Fungsi handler untuk health check
fun health_handler(req, res):
    print("Health check request")
    health_data = {
        "status": "healthy",
        "server": "uddin-lang-http",
        "timestamp": time(),
        "uptime": "running"
    }
    http_response(res, 200, {"Content-Type": "application/json"}, health_data)
end

// Fungsi handler untuk API info
fun info_handler(req, res):
    print("Info request diterima")
    info_data = {
        "server_name": "Uddin-Lang HTTP Server",
        "version": "1.0.0",
        "language": "Uddin-Lang",
        "endpoints": [
            "/hello - GET request untuk greeting",
            "/health - GET request untuk health check",
            "/info - GET request untuk server info"
        ]
    }
    http_response(res, 200, {"Content-Type": "application/json"}, info_data)
end

// Mulai server HTTP
port = 8080
server_id = "graceful-server"

print("Memulai HTTP server pada port " + str(port) + "...")
server_result = http_server_start(port, server_id)

print("Server berhasil dimulai!")
print("Server type: " + server_result["type"])
print("Server ID: " + server_result["server_id"])
print("Port: " + str(server_result["port"]))
print("Address: " + server_result["address"])
print("")

// Konfigurasi routes
print("Mengkonfigurasi routes...")

http_server_route("GET", "/hello", hello_handler, server_id)
print("Route /hello dikonfigurasi")

http_server_route("GET", "/health", health_handler, server_id)
print("Route /health dikonfigurasi")

http_server_route("GET", "/info", info_handler, server_id)
print("Route /info dikonfigurasi")
    
    print("")
    print("Server berjalan di:")
    print("  http://localhost:" + str(port) + "/hello")
    print("  http://localhost:" + str(port) + "/health")
    print("  http://localhost:" + str(port) + "/info")
    print("")
    print("Tekan Ctrl+C untuk menghentikan server dengan graceful shutdown...")
    print("")
    
    // Loop utama dengan signal handling
    running = true
    counter = 0
    
    while (running):
        // Simulasi pekerjaan server dengan busy wait
        // Dalam implementasi nyata, ini akan menggunakan proper sleep/delay
        busy_wait = 0
        while (busy_wait < 100000):
            busy_wait = busy_wait + 1
        end
        
        counter = counter + 1
        
        // Print status setiap 10 iterasi (simulasi 10 detik)
        if (counter % 10 == 0) then:
            print("Server masih berjalan... (" + str(counter) + " iterasi)")
        end
        
        // Simulasi pengecekan signal interrupt (Ctrl+C)
        // Dalam implementasi nyata, ini akan menggunakan signal handling
        // Untuk demo ini, kita akan berhenti setelah 60 iterasi
        if (counter >= 60) then:
            print("")
            print("Demo timeout tercapai (60 iterasi), melakukan graceful shutdown...")
            running = false
        end
    end
    
// Graceful shutdown
print("")
print("Melakukan graceful shutdown...")
print("Menunggu request yang sedang berjalan selesai...")

// Simulasi menunggu request selesai
// Dalam implementasi nyata, ini akan menggunakan proper delay
wait_counter = 0
while (wait_counter < 50000):
    wait_counter = wait_counter + 1
end

print("Menghentikan server...")
http_server_stop(server_id)
print("Server berhasil dihentikan dengan graceful!")
print("Goodbye!")

print("")
print("=== Demo Selesai ===")