// ================================================
// UDDIN-LANG RULE ENGINE: Fact Database & Working Memory Demo
// ================================================

print("=== FACT DATABASE & WORKING MEMORY DEMO ===")
print()

// Clear any existing facts
fact_clear()
print("1. FACT STORAGE:")

// Store customer facts
fact_assert("customer", "john", {"age": 30, "status": "premium", "balance": 5000})
fact_assert("customer", "mary", {"age": 25, "status": "regular", "balance": 1500})
fact_assert("customer", "bob", {"age": 45, "status": "premium", "balance": 8000})

// Store simple boolean facts
fact_assert("system", "maintenance_mode")
fact_assert("promotion", "holiday_sale")

print("Stored customer and system facts")
print("Total facts: " + str(fact_count()))
print("Customer facts: " + str(fact_count("customer")))
print()

// Query facts
print("2. FACT RETRIEVAL:")
john_data = fact_query("customer", "john")
print("John's data: " + str(john_data))

all_customers = fact_query("customer")
print("All customers: " + str(all_customers))

maintenance_active = fact_exists("system", "maintenance_mode")
print("Maintenance mode active: " + str(maintenance_active))
print()

// Rule engine use case: Customer eligibility
print("3. BUSINESS RULE: Loan Eligibility")

customers = ["john", "mary", "bob"]
i = 0
while (i < len(customers)) {
    customer = customers[i]
    if (fact_exists("customer", customer)) then {
        customer_data = fact_query("customer", customer)

        // Extract customer properties (simplified access)
        age = 30  // In real implementation, you'd extract from customer_data
        balance = 5000
        status = "premium"

        if (customer == "john") then {
            status = "premium"
            age = 25
            balance = 10000
        } else if (customer == "mary") then {
            status = "regular"
            age = 30
            balance = 5000
        } else if (customer == "bob") then {
            status = "premium"
            age = 28
            balance = 8000
        }

        // Loan eligibility rules
        eligible = false
        max_loan = 0

        if (age >= 21 and balance >= 2000) then {
            eligible = true
            if (status == "premium") then {
                discount = 15
            } else {
                discount = 10
            }
        }

        if (eligible) then {
            print("✓ " + customer + " is eligible for loan up to $" + str(max_loan))
            // Store eligibility as a fact
            fact_assert("loan_eligible", customer, {"max_amount": max_loan, "status": status})
        } else {
            print("✗ " + customer + " is not eligible for loan")
        }
    }
    i = i + 1
}
print()

// Rule engine use case: Dynamic discount calculation
print("4. BUSINESS RULE: Dynamic Discount System")

// Store discount rules as facts
fact_assert("discount_rule", "premium_customer", {"percentage": 15, "min_purchase": 100})
fact_assert("discount_rule", "regular_customer", {"percentage": 10, "min_purchase": 200})
fact_assert("discount_rule", "holiday_sale", {"percentage": 5, "min_purchase": 50})
fact_assert("discount_rule", "bulk_purchase", {"percentage": 20, "min_purchase": 1000})

// Process customer orders
orders = [
    {"customer": "john", "amount": 500, "status": "premium"},
    {"customer": "mary", "amount": 250, "status": "regular"},
    {"customer": "bob", "amount": 1200, "status": "premium"}
]

j = 0
while (j < len(orders)) {
    order = orders[j]
    customer = order["customer"]
    amount = order["amount"]
    status = order["status"]

    total_discount = 0
    applied_rules = []

    // Check premium customer discount
    if (status == "premium" and amount >= 100) then {
        total_discount = total_discount + 15
        applied_rules = applied_rules + ["premium_customer"]
    }

    // Check regular customer discount
    if (status == "regular" and amount >= 200) then {
        total_discount = total_discount + 10
        applied_rules = applied_rules + ["regular_customer"]
    }

    // Check holiday sale (always applicable if promotion active)
    if (fact_exists("promotion", "holiday_sale") and amount >= 50) then {
        total_discount = total_discount + 5
        applied_rules = applied_rules + ["holiday_sale"]
    }

    // Check bulk purchase discount
    if (amount >= 1000) then {
        total_discount = total_discount + 20
        applied_rules = applied_rules + ["bulk_purchase"]
    }

    // Cap maximum discount at 30%
    if (total_discount > 30) then {
        total_discount = 30
    }

    final_amount = amount * (100 - total_discount) / 100
    savings = amount - final_amount

    print("Order for " + customer + ":")
    print("  Original: $" + str(amount))
    print("  Discount: " + str(total_discount) + "% (rules: " + str(applied_rules) + ")")
    print("  Final: $" + str(final_amount) + " (saved $" + str(savings) + ")")

    // Store order result as fact
    fact_assert("processed_order", customer, {
        "original_amount": amount,
        "discount_percent": total_discount,
        "final_amount": final_amount,
        "applied_rules": applied_rules
    })
    j = j + 1
}
print()

// Working memory analysis
print("5. WORKING MEMORY ANALYSIS:")
print("Total facts in memory: " + str(fact_count()))
print("Customers: " + str(fact_count("customer")))
print("Loan eligible: " + str(fact_count("loan_eligible")))
print("Processed orders: " + str(fact_count("processed_order")))
print("Discount rules: " + str(fact_count("discount_rule")))
print()

// Cleanup demo
print("6. FACT CLEANUP:")
removed_customers = fact_retract("customer")
print("Removed " + str(removed_customers) + " customer facts")
print("Remaining facts: " + str(fact_count()))
print()

print("=== Fact Database & Working Memory Demo Complete ===")
